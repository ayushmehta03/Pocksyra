APP_ENV=development
PORT=8080

# Mongo must be a replica set (needed later for balance transactions)
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGO_DB=pocksyra

# At least 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars

ACCESS_TTL=15m
REFRESH_TTL=720h

# false for http://localhost, true in production (https)
COOKIE_SECURE=false
COOKIE_DOMAIN=
