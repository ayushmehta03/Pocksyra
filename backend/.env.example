APP_ENV=development
PORT=8090

# Local Mongo runs as a single-node replica set via ../docker-compose.yml (host port 27018).
# It MUST be a replica set: expenses and balances are written in transactions.
MONGO_URI=mongodb://localhost:27018/?directConnection=true
MONGO_DB=pocksyra

# At least 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars

ACCESS_TTL=15m
REFRESH_TTL=720h

# false for http://localhost, true in production (https)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted (leave empty locally)
TRUSTED_PROXIES=

# Google sign-in (create an OAuth client at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorised redirect URI in Google Cloud. In production use your https domain.
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:3000
