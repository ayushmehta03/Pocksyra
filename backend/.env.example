APP_ENV=development
PORT=8080

# Local Mongo runs as a single-node replica set via ../docker-compose.yml
MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DB=pocksyra

# At least 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32+chars

ACCESS_TTL=15m
REFRESH_TTL=720h

# false for http://localhost, true in production (https)
COOKIE_SECURE=false
COOKIE_DOMAIN=

# Comma-separated proxy IPs/CIDRs whose X-Forwarded-For is trusted (leave empty locally)
TRUSTED_PROXIES=

#
